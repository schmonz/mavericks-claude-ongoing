#!/bin/sh
# Resolves the current user's Anthropic-managed install at ~/.local/bin/claude,
# patches the binary in place if it lacks the Mavericks dylib wrappers, and
# execs it with the computer-use MCP wired in.
set -e

MF=$HOME/.local/share/claude-mavericks
ANTHROPIC_LINK=$HOME/.local/bin/claude
INSTALLER_URL=https://mavericksforever.com/claude/install.sh

export USE_BUILTIN_RIPGREP=0
export DISABLE_INSTALLATION_CHECKS=1
# Drops idle CPU from ~150% to <0.1%.
export JSC_numberOfGCMarkers=1

# First-run / partial-install bootstrap for this user. CLAUDE_MF_BOOTSTRAP tells
# the installer not to touch the shared /usr/local/bin wrapper: this very wrapper
# is already running, so it's good enough, and a new (possibly non-admin) user
# shouldn't get a sudo prompt just to launch claude. Wrapper refreshes happen
# when an admin re-runs the installer directly.
if [ ! -d "$MF" ] || [ ! -e "$ANTHROPIC_LINK" ]; then
    echo "claude: first run for $USER — setting up..." >&2
    curl -fsSL "$INSTALLER_URL" | CLAUDE_MF_BOOTSTRAP=1 sh >&2
fi

# The native binary is built for Haswell (AVX2+FMA+BMI). On older CPUs that lack
# AVX2 (pre-2013 Macs) those instructions fault; libavxemu.dylib installs a
# SIGILL handler that traps and emulates them. Loaded only when AVX2 is absent,
# so AVX2-capable Macs keep running natively at full speed. Decided after the
# bootstrap above so a freshly-downloaded dylib is picked up on first run.
if [ -f "$MF/libavxemu.dylib" ] && ! sysctl -n machdep.cpu.leaf7_features 2>/dev/null | grep -qiw AVX2; then
    export DYLD_INSERT_LIBRARIES="$MF/libavxemu.dylib${DYLD_INSERT_LIBRARIES:+:$DYLD_INSERT_LIBRARIES}"
fi

# ---- wide-character hook defense (no-AVX2 machines only) --------------------
# Claude >= 2.1.183 embeds a Bun-fork engine that hangs INDEFINITELY (100% CPU
# at a responsive-looking prompt) on this machine class when any SessionStart
# hook emits a character above U+00FF: the char flips the string to JSC's
# 16-bit representation, whose ingestion path never terminates under emulated
# AVX2. One em-dash in a plugin's SKILL.md is enough. Root-caused 2026-07-02.
# Until the engine is fixed:
#   1. transliterate known-wide punctuation in plugin skill payloads (the one
#      case in the wild: superpowers' using-superpowers/SKILL.md), idempotent;
#   2. preflight every ENABLED plugin's SessionStart hook and refuse to launch
#      if its output still contains wide characters — better a clear message
#      than a silent hang. CLAUDE_MF_ALLOW_WIDE_HOOKS=1 bypasses both.
if [ -n "$DYLD_INSERT_LIBRARIES" ] && [ -z "$CLAUDE_MF_ALLOW_WIDE_HOOKS" ]; then
    WLO=$(printf '\304'); WHI=$(printf '\364')   # UTF-8 lead bytes of U+0100..
    has_wide() { LC_ALL=C grep -q "[$WLO-$WHI]"; }
    plugin_enabled() {  # $1 = plugin, $2 = marketplace
        [ -f "$HOME/.claude/settings.json" ] && \
        LC_ALL=C grep -q "\"$1@$2\"[[:space:]]*:[[:space:]]*true" "$HOME/.claude/settings.json"
    }
    EM=$(printf '\342\200\224'); EN=$(printf '\342\200\223')
    AR=$(printf '\342\206\222'); NE=$(printf '\342\211\240')
    for hk in "$HOME"/.claude/plugins/cache/*/*/*/hooks/session-start; do
        [ -f "$hk" ] || continue
        PROOT=$(dirname "$(dirname "$hk")")
        PLUGIN=$(basename "$(dirname "$PROOT")")
        MARKET=$(basename "$(dirname "$(dirname "$PROOT")")")
        plugin_enabled "$PLUGIN" "$MARKET" || continue
        # (1) known remediation: ASCII-fy wide punctuation in the skill file
        # this hook reads. Backup kept beside it; re-runs are no-ops.
        SK="$PROOT/skills/using-superpowers/SKILL.md"
        if [ -f "$SK" ] && has_wide < "$SK"; then
            if sed -i.wide-bak -e "s/$EM/--/g" -e "s/$EN/-/g" \
                               -e "s/$AR/->/g" -e "s/$NE/!=/g" "$SK"; then
                echo "claude: sanitized wide punctuation in $SK (backup: $SK.wide-bak)" >&2
            fi
        fi
        # (2) preflight: run the hook the way Claude would; refuse on wide output.
        if CLAUDE_PLUGIN_ROOT="$PROOT" DYLD_INSERT_LIBRARIES= \
           /usr/bin/perl -e 'alarm 15; exec @ARGV' /bin/bash "$hk" 2>/dev/null | has_wide; then
            cat >&2 <<EOM
claude: REFUSING TO START.
The SessionStart hook of plugin '$PLUGIN' ($hk)
emits characters above U+00FF (em-dashes, arrows, curly quotes, ...).
On this no-AVX2 Mac, Claude >= 2.1.183 hangs FOREVER at 100% CPU ingesting
such hook output. Fix the plugin's payload (usually punctuation in a
SKILL.md under $PROOT/skills/),
disable the plugin, or re-run with CLAUDE_MF_ALLOW_WIDE_HOOKS=1 to launch
anyway (expect the hang).
EOM
            exit 1
        fi
    done
fi
# -----------------------------------------------------------------------------

# Resolve symlink to the actual versioned binary.
REAL=$(readlink "$ANTHROPIC_LINK" 2>/dev/null || echo "$ANTHROPIC_LINK")
case "$REAL" in /*) ;; *) REAL="$(dirname "$ANTHROPIC_LINK")/$REAL" ;; esac
[ -f "$REAL" ] || { echo "claude: $REAL does not exist." >&2; exit 1; }

# Patch in place if needed. Anthropic's auto-updater drops a fresh unpatched
# binary at ~/.local/share/claude/versions/<ver>; we re-check on every launch.
# The post-install validator inside the binary only stat-checks (size>0,
# S_IXUSR), so an in-place rewrite passes its checks.
#
# Newer Claude builds leave very little Mach-O header padding. Keep replacement
# install names short and put aliases beside the versioned binary so
# change_dylib can rewrite LC_LOAD_DYLIB commands without growing the header.
REAL_DIR=$(dirname "$REAL")
ln -sf "$MF/libSystemWrapper.dylib" "$REAL_DIR/libS.dylib" || { echo "claude: libS alias failed" >&2; exit 1; }
ln -sf "$MF/libicucoreWrapper.dylib" "$REAL_DIR/libI.dylib" || { echo "claude: libI alias failed" >&2; exit 1; }
ln -sf "$MF/libc++.1.dylib" "$REAL_DIR/libc++.1.dylib" || { echo "claude: libc++ alias failed" >&2; exit 1; }
ln -sf "$MF/libc++abi.1.dylib" "$REAL_DIR/libc++abi.1.dylib" || { echo "claude: libc++abi alias failed" >&2; exit 1; }

# Load commands live in the first few KB; grepping only there instead of the
# whole 224MB binary saves ~2.5s per launch (see Mavericks-Porting-Resources/
# STARTUP_LAUNCHER_FIX.md) and can't false-match dylib names inside __text.
if ! head -c 1048576 "$REAL" 2>/dev/null | grep -qE 'libSystemWrapper\.dylib|libS\.dylib'; then
    echo "claude: patching $(basename "$REAL")..." >&2
    T="$REAL.mf-tmp.$$"
    trap 'rm -f "$T"' EXIT INT TERM
    "$MF/patch_macho"     "$REAL" "$T" >/dev/null || { echo "claude: patch_macho failed"     >&2; exit 1; }
    "$MF/add_version_min" "$T"         >/dev/null || { echo "claude: add_version_min failed" >&2; exit 1; }
    "$MF/change_dylib"    "$T" \
        -change "/usr/lib/libSystem.B.dylib"  "@loader_path/libS.dylib" \
        -change "/usr/lib/libicucore.A.dylib" "@loader_path/libI.dylib" \
        -change "/usr/lib/libc++.1.dylib"     "@loader_path/libc++.1.dylib" \
        >/dev/null || { echo "claude: change_dylib failed" >&2; exit 1; }
    chmod +x "$T"
    mv "$T" "$REAL"
    trap - EXIT INT TERM
fi

# Always load managed settings: registers the grep-fix hook (the native build
# shadows `grep` with an embedded ugrep that SIGSEGVs on 10.9) and carries the
# computer-use MCP permission. Then wire in the computer-use MCP itself if
# installed. mcp-config.json carries the user's absolute path to mcp_server.py —
# baked in at install time since the MCP loader doesn't expand env vars in JSON.
# NOTE: equals-form flags — the space form makes --mcp-config swallow trailing
# positional args (e.g. `claude install 2.1.197` failed as "MCP config file
# not found: .../install").
CU="$MF/computer-use"
ARGS=""
[ -f "$MF/settings.json" ] && ARGS="--settings=$MF/settings.json"
if [ -f "$CU/mcp-config.json" ] && [ -x "$CU/mcp_server.py" ]; then
    ARGS="$ARGS --mcp-config=$CU/mcp-config.json"
fi

exec "$REAL" $ARGS "$@"
